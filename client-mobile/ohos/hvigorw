#!/bin/bash
# flutter ohos 工具链（3.7.12 分支）在主工程阶段会调用本脚本跑 hvigor 任务。
# 工程本地不再有 hvigor node_modules（2023 版 hvigor4 与 API26 SDK 互不识别），
# 直接委托给 DevEco Studio 自带的 hvigor6——这是当前唯一穿透的构建路径
# （见 docs/design/MOBILE_PLAN_V2.md 鸿蒙章节与 67f9ada 提交记录）。
#
# DEVECO_SDK_HOME 由本脚本兜底导出，避免 hvigor 报 00303217 配置错误。
set -e

DEVECO="${DEVECO_STUDIO_DIR:-/Applications/DevEco-Studio.app}"
HVIGORW="$DEVECO/Contents/tools/hvigor/bin/hvigorw"
if [ ! -x "$HVIGORW" ]; then
  echo "找不到 DevEco hvigorw：$HVIGORW（安装 DevEco Studio 或用 DEVECO_STUDIO_DIR 指定）" >&2
  exit 1
fi
export DEVECO_SDK_HOME="${DEVECO_SDK_HOME:-$DEVECO/Contents/sdk}"
exec "$HVIGORW" "$@"
