{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 调试/CI 注入口：aa start -U "unidropmobile://setup?server=…&account=…&psk=…"
            // 鸿蒙 platform channel 断流期间无法用键盘改设置，经 URI 落盘
            // bootstrap_config.json 由 Dart 在 native.start 前读取覆盖。
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "unidropmobile"
              }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {"name" :  "ohos.permission.INTERNET"},
      {
        // 读蓝牙本机名（华为设备蓝牙名默认跟随「关于本机」设备名称），
        // 用于 roster 上报真实设备名；user_grant 且无需 profile 放行，
        // 零售机可装。运行时在 EntryAbility 弹窗申请。
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:device_name_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ]
  }
}