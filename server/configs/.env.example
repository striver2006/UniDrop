# UniDrop 中继服务端配置模板
#
# 服务端**只读环境变量**，不解析任何配置文件。此前这里放的是一份
# config.example.yaml，但全仓库没有一行 YAML 解析代码——照那份文件配置的人
# 得到的是完全的静默无效。本文件与实际生效的机制一致。
#
# 用法（任选其一）：
#   1. docker compose：把需要的项写进 docker-compose.yml 的 environment 块
#   2. 直接运行：  set -a; . ./configs/.env; set +a; ./unidrop-server
#   3. systemd：   EnvironmentFile=/etc/unidrop/env

# ---------- 基础 ----------

# HTTP / WebSocket 监听地址
UNIDROP_LISTEN_ADDR=:8080

# 客户端鉴权用的预共享密钥。**生产环境必须修改**，否则服务端会在启动日志里
# 持续告警。注意它是整个部署共用的一把钥匙：知道它的客户端可以声明任意
# account_id，账号隔离是便利分区而非安全边界。
#
# 这个取舍没有变。变的是「即使各方都守规矩也会互相误伤」的几处已经修掉：
# 跨账号的同名 device_id 不再互相顶号下线、自报一个 session_id 不再能拆掉
# 别人的传输管道、单个账号也不再能耗尽全实例的管道容量。
# 换言之账号仍不是安全边界，但不再是一个会随机伤到邻居的分区。
UNIDROP_PSK_SECRET=YOUR_SHARED_SECRET_KEY_HERE

# 内建 STUN 服务监听地址（RFC 8489），留空则不启动
UNIDROP_STUN_ADDR=:3478

# 心跳超时秒数：超过这个时长没收到 ping 的会话会被清理
UNIDROP_HEARTBEAT_TIMEOUT=45

# ---------- 传输限额 ----------
#
# 以下五项决定「多大的东西允许经本服务端中转」。超限时服务端会向发送方回一条
# TRANSFER_FAILURE，客户端据此提示「文件/剪贴板内容太大，无法传输」；
# 客户端在鉴权后会收到这组值，并在发送前先本地拦一道。
#
# 取值规则（三态）：
#   - 不设置该变量  → 取下面注释里的默认值
#   - 设为 0        → **关闭该项限制**
#   - 设为其它非负整数 → 原样生效
#
# 写错会怎样：非数字（如 "2GB"）、负数、带空格的值一律**退回默认值并打 warn**，
# 不会变成 0。这一点是刻意的——0 在这里表示「不限制」，若解析失败直接取 0，
# 一个拼错的值就会静默解除限制，而你以为刚刚配好了上限。
# 启动日志里有一行 "transfer limits in effect"，核对它即可确认实际生效值。
#
# 单位一律是**字节**，且 1 MB = 1024×1024。

# 单个文件字节上限（默认 134217728 = 128 MB）
# 只对 data_type=FILES 生效；剪贴板图片/文本走下面各自的那条，互不叠加。
#UNIDROP_MAX_SINGLE_FILE_BYTES=134217728

# 单次传输总字节上限（默认 268435456 = 256 MB）
# 对所有类型生效，包括剪贴板图片。调高图片上限时别忘了它，
# 否则图片会先撞这条。
#UNIDROP_MAX_TOTAL_TRANSFER_BYTES=268435456

# 剪贴板图片字节上限（默认 67108864 = 64 MB）
#UNIDROP_MAX_CLIPBOARD_IMAGE_BYTES=67108864

# 剪贴板文本字节上限（默认 4194304 = 4 MB）
# 4 MB 文本约等于四百万字符，正常剪贴内容达不到；超过多半是误操作或程序输出。
#UNIDROP_MAX_CLIPBOARD_TEXT_BYTES=4194304

# 单次 offer 的条目数上限（默认 64）
#
# 客户端不会递归展开目录，所以这个数的用户可见含义就是「一次最多选几个文件」。
#
# **调大它之前先看这条**：控制面单条消息有 512 KiB 的读上限
# （control_ws.go 的 SetReadLimit），而 offer 的每个条目大约占 200–400 字节
# （含相对路径与 64 字符的 sha256，路径越长越大）。条目数调到 1000 以上时，
# offer 报文可能越过 512 KiB —— 那种情况下 websocket 库会**直接断连**，
# 服务端根本没机会回这条 TRANSFER_FAILURE，用户看到的是掉线而不是拒绝提示。
# 保守建议不超过 512。
#UNIDROP_MAX_ITEMS_PER_OFFER=64

# 单账号同时进行的传输数上限（默认 8）
#
# 「同时进行」= 已授权但尚未终结的会话。注意它按 account_id 计数，而
# account_id 由客户端自报，所以这是**容量保护**，不是安全边界。
#
# 这个数**同时**被用作每账号的在途中继管道数上限——没有第二个变量。
# 一个已授权的会话恰好对应一条管道，两者约束的是同一种资源、单位也相同；
# 再开一个旋钮只会在两者取值不一致时产生谁也说不清的行为。
# 0 = 关闭（两项一起关闭）。
#UNIDROP_MAX_CONCURRENT_TRANSFERS=8
