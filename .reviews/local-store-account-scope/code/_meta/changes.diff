+/// 三个直接操作会话文件的 IPC 命令共用的归属闸门。
+///
+/// 见 `HistoryRepo::session_belongs_to` 的注释：过滤列表只保证「看不见」，
+/// 挡不住「点得动」。切账号后界面若还残留着旧账号的卡片，用户点下去就会
+/// 真的读到另一个账号的文件。
+pub(crate) async fn ensure_session_owned(state: &State<'_, AppState>, session_id: &str) -> Result<(), String> {
