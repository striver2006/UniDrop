+        let sid = Uuid::new_v4();
+        let key = test_key(&sid);
+        // 恰好等于一个明文满块：不加密时 1 块，加密时因为块长少 16 字节而变成 2 块
+        let size = MAX_PAYLOAD_LENGTH as usize;
+        let bytes = vec![9u8; size];
+
+        let (plain_offer, _) =
+            TransferEngine::prepare_offer_from_bytes(sid, "IMAGE", "a.png", bytes.clone(), None).unwrap();
+        let (enc_offer, _) =
