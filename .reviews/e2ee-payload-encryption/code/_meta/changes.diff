+            "三个不同块各失败一次后必须熔断——只按单块计数会在这里放行并无限重传"
+        );
+    }
+
+    /// 同一块连续失败同样要熔断（更窄的情形，由单块阈值负责）。
+    #[test]
+    fn repeated_failure_on_one_chunk_trips_the_breaker() {
+        let mut per = std::collections::HashMap::new();
+        let mut total = 0u32;
+        assert!(!record_tag_failure(&mut per, &mut total, 5, 5));
+        assert!(!record_tag_failure(&mut per, &mut total, 5, 5));
+        assert!(record_tag_failure(&mut per, &mut total, 5, 5));
     }
 }
