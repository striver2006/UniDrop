+    /// 用错 nonce 解不开——间接证明 nonce 真的参与了认证，
+    /// 也是"接收端自行重算 nonce"这个决定的安全依据。
+    #[test]
+    fn wrong_nonce_fails_to_open() {
+        let k = key_for(&Uuid::new_v4());
+        let ct = seal(&k, data_nonce(0, 0), b"payload").unwrap();
