+# 以下四项供 UNUserNotificationCenter 使用，属 objc2 0.6 那一代。
+# 与上面的 0.5 并存是刻意的，不是疏漏：0.6.4 早已由 tao/dispatch2 带进 macOS
+# 构建（见 Cargo.lock），两代在本 crate 内不交换任何类型——剪贴板那几个文件只碰
+# 0.5，通知这个文件只碰 0.6。把剪贴板一并升到 0.6 需要改写全部 FFI
+# （Id → Retained、msg_send_id! → msg_send!、declare_class! → define_class!），
+# 那是给本次需求之外的稳定代码引入回归风险，收益与风险不成比例。
+objc2-v06 = { package = "objc2", version = "0.6" }
+objc2-foundation-v06 = { package = "objc2-foundation", version = "0.3", features = [
+    "NSString",
