+    "NSBundle",
+] }
+objc2-user-notifications = { version = "0.3", features = [
+    "UNUserNotificationCenter",
+    # UNNotificationContent 已覆盖 UNMutableNotificationContent，无需单列。
+    "UNNotificationContent",
+    "UNNotificationRequest",
+    "UNNotificationResponse",
+    "UNNotificationTrigger",
+    "UNNotificationSound",
+    # willPresent 回调被 cfg(all(feature = "UNNotification", feature = "block2"))
+    # 门控，缺它则「应用在前台时通知照常显示」根本无从实现。
+    "UNNotification",
+    "UNError",
+    "block2",
+] }
+block2 = "0.6"
+
 [dev-dependencies]
 # 只为 tls_trust 的端到端分类测试而在：起一个本地自签 TLS 监听器，真握一次手，
